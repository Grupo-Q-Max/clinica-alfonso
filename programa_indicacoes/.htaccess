# Proteção de arquivos sensíveis do sistema de indicações
<FilesMatch "^(\.env|composer\.(json|lock)|.*\.sql|.*\.log|.*\.db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

